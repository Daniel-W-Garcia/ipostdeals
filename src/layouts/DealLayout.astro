---
// src/layouts/DealLayout.astro
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

export interface Props {
    deal: CollectionEntry<'deals'>;
}

const { deal } = Astro.props;
const { title, store, price, originalPrice, category, tags, coupon, url, expires } = deal.data;

const discount = Math.round((1 - price / originalPrice) * 100);
const formattedPrice = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
}).format(price);
const formattedOriginal = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
}).format(originalPrice);
---

<BaseLayout title={title} description={`${title} — ${discount}% off at ${store}. Price: ${formattedPrice} (was ${formattedOriginal}).`}>
  <article class="deal">
    <div class="container-narrow">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/deals/">Deals</a>
        <span>/</span>
        <span class="current">{store}</span>
      </nav>

        <!-- Meta -->
      <div class="deal-meta">
        <span class="category">{category}</span>
        <span class="separator">&middot;</span>
        <span class="store">{store}</span>
      </div>

      <h1>{title}</h1>

        <!-- Price Block -->
      <div class="price-block">
        <div class="price-main">
          <span class="price">{formattedPrice}</span>
          <span class="original">{formattedOriginal}</span>
          <span class="discount">Save {discount}%</span>
        </div>

          {coupon && (
                  <div class="coupon-box">
            <span class="coupon-label">Use code:</span>
            <code>{coupon}</code>
          </div>
          )}

          <a href={url} target="_blank" rel="noopener" class="btn btn-primary">
          View Deal &rarr;
        </a>
      </div>

        <!-- Content -->
      <div class="deal-content">
        <slot />
      </div>

        <!-- Tags -->
      <div class="tags">
        {tags.map((tag: string) => (
                <span class="tag">{tag}</span>
        ))}
      </div>

        {expires && (
                <p class="expires">
          ⏰ Expires: {new Date(expires).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                })}
        </p>
        )}
    </div>
  </article>
</BaseLayout>

<style>
  .deal {
      padding: 3rem 0;
  }

  /* Breadcrumb */
  .breadcrumb {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      display: flex;
      gap: 0.5rem;
      align-items: center;
  }

  .breadcrumb a {
      color: var(--text-muted);
  }

  .breadcrumb a:hover {
      color: var(--text-primary);
  }

  .breadcrumb .current {
      color: var(--text-secondary);
  }

  /* Meta */
  .deal-meta {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      font-size: 0.85rem;
      margin-bottom: 0.75rem;
  }

  .category {
      color: var(--accent);
      font-weight: 600;
      text-transform: capitalize;
  }

  .store {
      color: var(--text-secondary);
  }

  .separator {
      color: var(--border-light);
  }

  h1 {
      margin-bottom: 1.5rem;
  }

  /* Price Block */
  .price-block {
      background-color: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      margin-bottom: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
  }

  .price-main {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      flex-wrap: wrap;
  }

  .price {
      font-size: 2rem;
      font-weight: 700;
      color: var(--success);
  }

  .original {
      font-size: 1.125rem;
      color: var(--text-muted);
      text-decoration: line-through;
  }

  .discount {
      font-size: 0.9rem;
      font-weight: 700;
      color: #fff;
      background-color: var(--sale);
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
  }

  .coupon-box {
      background-color: var(--bg-secondary);
      border: 1px dashed var(--border-light);
      border-radius: var(--radius);
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
  }

  .coupon-label {
      font-size: 0.85rem;
      color: var(--text-secondary);
  }

  .coupon-box code {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 600;
      color: var(--warning);
      background: none;
  }

  .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.75rem;
      border-radius: var(--radius);
      font-weight: 600;
      font-size: 1rem;
      transition: background-color 0.15s, color 0.15s, box-shadow 0.15s;
      cursor: pointer;
      text-align: center;
  }

  .btn-primary {
      background-color: var(--accent);
      color: #fff;
  }

  .btn-primary:hover {
      background-color: var(--accent-hover);
      color: #fff;
      box-shadow: 0 0 24px rgba(59, 130, 246, 0.3);
  }

  /* Content */
  .deal-content {
      line-height: 1.8;
  }

  .deal-content :global(h2) {
      font-size: 1.375rem;
      margin: 2rem 0 0.75rem;
  }

  .deal-content :global(ul),
  .deal-content :global(ol) {
      padding-left: 1.5rem;
      margin-bottom: 1rem;
      color: var(--text-secondary);
  }

  .deal-content :global(li) {
      margin-bottom: 0.35rem;
  }

  .deal-content :global(strong) {
      color: var(--text-primary);
  }

  /* Tags */
  .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
  }

  .tag {
      font-size: 0.75rem;
      padding: 0.2rem 0.65rem;
      border-radius: 10px;
      background-color: rgba(59, 130, 246, 0.1);
      color: var(--accent-hover);
      font-weight: 500;
  }

  .expires {
      margin-top: 1.5rem;
      font-size: 0.85rem;
      color: var(--text-muted);
  }
</style>
