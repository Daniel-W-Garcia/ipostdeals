---
const sourceInfoUrl = 'https://www.nasdisks.com/data/';
---

<section
    class="nas-streamer"
    data-nas-market-streamer
    hidden
    aria-labelledby="nas-market-title"
>
  <div class="streamer-inner">
    <div class="market-label" id="nas-market-title">
      <span class="live-dot" aria-hidden="true"></span>
      <span>NAS MARKET · US</span>
    </div>

    <ul
        class="stream-items"
        data-nas-market-items
        aria-label="Current United States NAS drive price references"
    ></ul>

    <a
        class="credit"
        href={sourceInfoUrl}
        target="_blank"
        rel="noopener noreferrer"
    >
      Prices refreshed by NASdisks.com ↗
    </a>
  </div>
</section>

<script>
    type CheapestItem = {
        model: string;
        name: string;
        brand: string;
        capacity_tb: number;
        price: number;
        per_tb: number;
        currency: string;
        url: string;
    };

    type CheapestResponse = {
        items?: unknown;
    };

    const NASDISKS_ENDPOINT =
        'https://www.nasdisks.com/embed/cheapest.json?region=US&n=20';

    function isRecord(value: unknown): value is Record<string, unknown> {
        return typeof value === 'object' && value !== null;
    }

    function isHttpUrl(value: unknown): value is string {
        if (typeof value !== 'string') {
            return false;
        }

        try {
            const url = new URL(value);
            return url.protocol === 'http:' || url.protocol === 'https:';
        } catch {
            return false;
        }
    }

    function parseItem(value: unknown): CheapestItem | null {
        if (!isRecord(value)) {
            return null;
        }

        const model = typeof value.model === 'string' ? value.model : '';
        const name = typeof value.name === 'string' ? value.name : model;
        const brand = typeof value.brand === 'string' ? value.brand : '';
        const capacity = Number(value.capacity_tb);
        const price = Number(value.price);
        const perTb = Number(value.per_tb);
        const currency =
            typeof value.currency === 'string' && value.currency.trim()
                ? value.currency.trim()
                : 'USD';

        if (
            !name.trim() ||
            !Number.isFinite(capacity) ||
            capacity <= 0 ||
            !Number.isFinite(price) ||
            price <= 0 ||
            !Number.isFinite(perTb) ||
            perTb <= 0 ||
            !isHttpUrl(value.url)
        ) {
            return null;
        }

        return {
            model,
            name,
            brand,
            capacity_tb: capacity,
            price,
            per_tb: perTb,
            currency,
            url: value.url,
        };
    }

    function formatCurrency(value: number, currency: string): string {
        try {
            return new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency,
                maximumFractionDigits: 2,
            })
                .format(value)
                .replace(/\.00$/, '');
        } catch {
            return `$${value.toFixed(2)}`;
        }
    }

    function formatCapacity(value: number): string {
        if (Number.isInteger(value)) {
            return `${value}TB`;
        }

        return `${value.toFixed(2).replace(/\.?0+$/, '')}TB`;
    }

    function selectOneItemPerCapacity(
        items: CheapestItem[],
    ): CheapestItem[] {
        const lowestByCapacity = new Map<number, CheapestItem>();

        for (const item of items) {
            const current = lowestByCapacity.get(item.capacity_tb);

            if (!current || item.per_tb < current.per_tb) {
                lowestByCapacity.set(item.capacity_tb, item);
            }
        }

        return [...lowestByCapacity.values()].sort(
            (left, right) => left.capacity_tb - right.capacity_tb,
        );
    }

    function createPriceChip(item: CheapestItem): HTMLLIElement {
        const listItem = document.createElement('li');
        const link = document.createElement('a');
        const capacity = document.createElement('strong');
        const price = document.createElement('span');
        const perTb = document.createElement('em');

        link.className = 'stream-item';
        link.href = item.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.ariaLabel = `View ${item.name} at ${formatCurrency(
            item.price,
            item.currency,
        )}, ${formatCurrency(item.per_tb, item.currency)} per TB`;

        capacity.textContent = formatCapacity(item.capacity_tb);
        price.textContent = formatCurrency(item.price, item.currency);
        perTb.textContent = `${formatCurrency(item.per_tb, item.currency)}/TB`;

        link.append(capacity, document.createTextNode(' '), price);
        link.append(document.createTextNode(' · '), perTb);
        listItem.append(link);

        return listItem;
    }

    async function loadMarketItems(streamer: HTMLElement): Promise<void> {
        if (streamer.dataset.loaded === 'true') {
            return;
        }

        const itemsContainer = streamer.querySelector<HTMLElement>(
            '[data-nas-market-items]',
        );

        if (!itemsContainer) {
            return;
        }

        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 7000);

        try {
            const response = await fetch(NASDISKS_ENDPOINT, {
                headers: {
                    Accept: 'application/json',
                },
                signal: controller.signal,
            });

            if (!response.ok) {
                throw new Error(`NASdisks request failed: ${response.status}`);
            }

            const payload: unknown = await response.json();

            if (!isRecord(payload)) {
                throw new Error('NASdisks response was not an object');
            }

            const rawItems = (payload as CheapestResponse).items;

            if (!Array.isArray(rawItems)) {
                throw new Error('NASdisks response did not contain items');
            }

            const items = rawItems
                .map(parseItem)
                .filter((item): item is CheapestItem => item !== null);

            const displayItems = selectOneItemPerCapacity(items);

            if (displayItems.length === 0) {
                throw new Error('NASdisks response contained no usable items');
            }

            itemsContainer.replaceChildren(
                ...displayItems.map(createPriceChip),
            );
            streamer.dataset.loaded = 'true';
            streamer.hidden = false;
        } catch (error) {
            console.warn('NASdisks market streamer unavailable.', error);
            streamer.hidden = true;
        } finally {
            window.clearTimeout(timeout);
        }
    }

    document
        .querySelectorAll<HTMLElement>('[data-nas-market-streamer]')
        .forEach((streamer) => {
            void loadMarketItems(streamer);
        });
</script>

<style>
  .nas-streamer {
      border-top: 1px solid #32496a;
      border-bottom: 1px solid #32496a;
      background: #0e1828;
  }

  .streamer-inner {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      max-width: var(--content-width);
      margin-inline: auto;
      padding: 0.75rem 1.5rem;
  }

  .market-label {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: var(--text-primary);
      font-size: 0.72rem;
      font-weight: 800;
      white-space: nowrap;
  }

  .live-dot {
      width: 0.45rem;
      height: 0.45rem;
      flex: 0 0 auto;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.12);
  }

  .stream-items {
      display: flex;
      flex: 1;
      gap: 0.5rem;
      min-width: 0;
      margin: 0;
      padding: 0;
      overflow-x: auto;
      list-style: none;
      scrollbar-width: thin;
  }

  :global(.stream-item) {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 0.35rem;
      padding: 0.4rem 0.65rem;
      color: var(--text-secondary);
      background: #15233a;
      border: 1px solid #2c405f;
      border-radius: 999px;
      font-size: 0.75rem;
      line-height: 1.2;
      white-space: nowrap;
  }

  :global(.stream-item:hover) {
      color: var(--text-primary);
      background: #1b2d49;
      border-color: var(--accent);
  }

  :global(.stream-item:focus-visible),
  .credit:focus-visible {
      outline: 3px solid var(--accent-hover);
      outline-offset: 2px;
  }

  :global(.stream-item strong) {
      color: var(--text-primary);
      font-weight: 800;
  }

  :global(.stream-item em) {
      color: var(--success);
      font-style: normal;
      font-weight: 700;
  }

  .credit {
      flex: 0 0 auto;
      color: var(--accent);
      font-size: 0.72rem;
      white-space: nowrap;
  }

  .credit:hover {
      color: var(--accent-hover);
  }

  @media (max-width: 720px) {
      .streamer-inner {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.6rem;
          padding: 0.7rem 1rem;
      }

      .stream-items {
          width: 100%;
      }

      .credit {
          align-self: flex-end;
      }
  }
</style>
