---
import type { CollectionEntry } from 'astro:content';

export interface Props {
    deal: CollectionEntry<'deals'>;
}

const { deal } = Astro.props;

const {
    affiliateUrl,
    category,
    comparisonPrice,
    comparisonPriceLabel,
    coupon,
    featured,
    lastCheckedAt,
    price,
    retailerUrl,
    sourceName,
    sourceUrl,
    store,
    tags,
    title,
} = deal.data;

const outboundUrl = affiliateUrl ?? retailerUrl ?? sourceUrl;
const linkLabel =
    affiliateUrl || retailerUrl ? 'View deal' : 'View source deal';

const currencyFormatter = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
});

const dateFormatter = new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
});

let formattedComparison: string | null = null;
let discount: number | null = null;

if (
    comparisonPrice !== undefined &&
    comparisonPriceLabel !== undefined
) {
    formattedComparison = currencyFormatter.format(comparisonPrice);
    discount = Math.round((1 - price / comparisonPrice) * 100);
}

const externalRel = affiliateUrl ? 'sponsored' : undefined;
---

<a
        href={outboundUrl}
        class="card"
        rel={externalRel}
        aria-label={`${linkLabel}: ${title}`}
>
  {featured && <span class="badge badge-featured">Featured</span>}

    <div class="card-meta">
    <span class="category">{category}</span>
    <span class="store">{store}</span>
  </div>

  <h2 class="card-title">{title}</h2>

  <div class="price-row">
    <span class="price">{currencyFormatter.format(price)}</span>

      {formattedComparison && (
              <>
        <span class="original">{formattedComparison}</span>

                  {discount !== null && (
                          <span class="discount">-{discount}%</span>
                  )}
      </>
      )}
  </div>

    {comparisonPriceLabel && (
            <p class="comparison-label">{comparisonPriceLabel}</p>
    )}

    {coupon && (
            <div class="coupon">
      <span class="coupon-label">Code: </span>
      <code>{coupon}</code>
    </div>
    )}

    <p class="source">
    Source: {sourceName} · Checked {dateFormatter.format(lastCheckedAt)}
  </p>

    {tags.length > 0 && (
            <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    )}

    <span class="card-action">
    {linkLabel} <span aria-hidden="true">↗</span>
  </span>
</a>

<style>
  .card {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-height: 100%;
      padding: 1.25rem;
      position: relative;
      overflow: hidden;
      color: inherit;
      background-color: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      transition:
              border-color 0.15s,
              background-color 0.15s,
              transform 0.15s;
  }

  .card:hover,
  .card:focus-visible {
      color: inherit;
      background-color: var(--bg-card-hover);
      border-color: var(--accent);
      transform: translateY(-2px);
  }

  .card:focus-visible {
      outline: 3px solid var(--accent-hover);
      outline-offset: 3px;
  }

  .badge {
      position: absolute;
      top: 0;
      right: 0;
      padding: 0.2rem 0.75rem;
      border-radius: 0 0 0 var(--radius);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
  }

  .badge-featured {
      color: #fff;
      background-color: var(--accent);
  }

  .card-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
  }

  .category {
      color: var(--accent);
      font-weight: 600;
      text-transform: capitalize;
  }

  .store {
      color: var(--text-muted);
  }

  .card-title {
      margin: 0;
      display: -webkit-box;
      overflow: hidden;
      color: var(--text-primary);
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.4;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
  }

  .price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem;
  }

  .price {
      color: var(--success);
      font-size: 1.25rem;
      font-weight: 700;
  }

  .original {
      color: var(--text-muted);
      font-size: 0.875rem;
      text-decoration: line-through;
  }

  .discount {
      padding: 0.1rem 0.45rem;
      color: #fff;
      background-color: var(--sale);
      border-radius: 4px;
      font-size: 0.8rem;
      font-weight: 700;
  }

  .comparison-label,
  .source {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.8rem;
      line-height: 1.45;
  }

  .coupon {
      color: var(--text-secondary);
      font-size: 0.85rem;
  }

  .coupon code {
      padding: 0.1rem 0.4rem;
      color: var(--warning);
      background-color: var(--bg-secondary);
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 0.8rem;
  }

  .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-top: auto;
      padding-top: 0.5rem;
  }

  .tag {
      padding: 0.15rem 0.55rem;
      color: var(--accent-hover);
      background-color: var(--accent-muted);
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 500;
  }

  .card-action {
      margin-top: 0.5rem;
      color: var(--accent);
      font-size: 0.9rem;
      font-weight: 700;
  }
</style>
