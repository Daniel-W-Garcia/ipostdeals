---
import type { CollectionEntry } from 'astro:content';
import { getCategoryLabel } from '../lib/categories';


export interface Props {
    deal: CollectionEntry<'deals'>;
}

const { deal } = Astro.props;

const {
    affiliateUrl,
    category,
    comparisonPrice,
    comparisonPriceLabel,
    coupon,
    displayTitle,
    featured,
    lastCheckedAt,
    price,
    priceHistorySource,
    priceHistoryUrl,
    retailerUrl,
    sourceName,
    sourceUrl,
    store,
    title,
} = deal.data;

const cardTitle = displayTitle ?? title;


const outboundUrl = affiliateUrl ?? retailerUrl ?? sourceUrl;
const linkLabel =
    affiliateUrl || retailerUrl ? 'View deal' : 'View source deal';

const currencyFormatter = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
});

const dateFormatter = new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
});

let formattedComparison: string | null = null;
let discount: number | null = null;

if (
    comparisonPrice !== undefined &&
    comparisonPriceLabel !== undefined
) {
    formattedComparison = currencyFormatter.format(comparisonPrice);
    discount = Math.round((1 - price / comparisonPrice) * 100);
}

const externalRel = affiliateUrl ? 'sponsored' : undefined;
---

<article class="card">
  <a
          href={outboundUrl}
          class="card-main"
          rel={externalRel}
          aria-label={`${linkLabel}: ${title}`}
  >
    {featured && <span class="badge badge-featured">Featured</span>}

      <div class="card-meta">
      <span class="category">{getCategoryLabel(category)}</span>
      <span class="store">{store}</span>
    </div>

    <h2 class="card-title">{cardTitle}</h2>

    <div class="price-row">
      <span class="price">{currencyFormatter.format(price)}</span>

        {formattedComparison && (
                <>
          <span class="original">{formattedComparison}</span>

                    {discount !== null && (
                            <span class="discount">-{discount}%</span>
                    )}
        </>
        )}
    </div>

      {comparisonPriceLabel && (
              <p class="comparison-label">{comparisonPriceLabel}</p>
      )}

      {coupon && (
              <div class="coupon">
        <span class="coupon-label">Code: </span>
        <code>{coupon}</code>
      </div>
      )}

      <p class="source">
      Source: {sourceName} · Checked {dateFormatter.format(lastCheckedAt)}
    </p>

    <span class="card-action">
      {linkLabel} <span aria-hidden="true">↗</span>
    </span>
  </a>

    {priceHistoryUrl && (
            <a
                    href={priceHistoryUrl}
                    class="price-history"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`View price history on ${
                        priceHistorySource ?? 'PCPartPicker'
                    }`}
            >
      <span>Price history</span>
      <span class="price-history-link">
        View on {priceHistorySource ?? 'PCPartPicker'}
          <span aria-hidden="true">↗</span>
      </span>
    </a>
    )}
</article>



<style>
.card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
            border-color 0.15s,
            background-color 0.15s,
            transform 0.15s;
}

.card:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--accent);
    transform: translateY(-2px);
}


.card-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 0;
    padding: 1.25rem;
    color: inherit;
}

  .badge {
      position: absolute;
      top: 0;
      right: 0;
      padding: 0.2rem 0.75rem;
      border-radius: 0 0 0 var(--radius);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
  }

  .badge-featured {
      color: #fff;
      background-color: var(--accent);
  }

  .card-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
  }

  .category {
      color: var(--accent);
      font-weight: 600;
  }

  .store {
      color: var(--text-muted);
  }

  .card-title {
      margin: 0;
      display: -webkit-box;
      overflow: hidden;
      color: var(--text-primary);
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.4;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
  }

    .card-main:hover {
        color: inherit;
    }

    .card-main:focus-visible {
        outline: 3px solid var(--accent-hover);
        outline-offset: -3px;
    }

    .price-history {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.65rem 1.25rem 0.75rem;
        color: var(--text-muted);
        background-color: var(--bg-card);
        border-top: 1px solid var(--border);
        font-size: 0.8rem;
        line-height: 1.45;
    }

    .price-history:hover {
        color: var(--text-primary);
        background-color: var(--bg-card-hover);
    }

    .price-history:focus-visible {
        z-index: 1;
        outline: 3px solid var(--accent-hover);
        outline-offset: -3px;
    }

    .price-history-link {
        color: var(--accent);
        font-weight: 600;
    }

    .price-history:hover .price-history-link {
        text-decoration: underline;
    }



  .price-history a {
      color: var(--accent);
      font-weight: 600;
      text-decoration: none;
  }

  .price-history a:hover,
  .price-history a:focus-visible {
      text-decoration: underline;
  }

  .price-history a:focus-visible {
      outline: 3px solid var(--accent-hover);
      outline-offset: 2px;
  }

  .price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem;
  }

  .price {
      color: var(--success);
      font-size: 1.25rem;
      font-weight: 700;
  }

  .original {
      color: var(--text-muted);
      font-size: 0.875rem;
      text-decoration: line-through;
  }

  .discount {
      padding: 0.1rem 0.45rem;
      color: #fff;
      background-color: var(--sale);
      border-radius: 4px;
      font-size: 0.8rem;
      font-weight: 700;
  }

  .comparison-label,
  .source {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.8rem;
      line-height: 1.45;
  }

  .coupon {
      color: var(--text-secondary);
      font-size: 0.85rem;
  }

  .coupon code {
      padding: 0.1rem 0.4rem;
      color: var(--warning);
      background-color: var(--bg-secondary);
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 0.8rem;
  }

    .card-action {
        margin-top: auto;
        padding-top: 0.5rem;
        color: var(--accent);
        font-size: 0.9rem;
        font-weight: 700;
    }

</style>
