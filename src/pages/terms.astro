---
// src/pages/terms.astro
import BaseLayout from '../layouts/BaseLayout.astro';

// Bump this by hand only when the terms below actually change.
// Do NOT use new Date() here: that renders the build date, so every routine
// rebuild would tell visitors the terms had just changed.
const LAST_UPDATED = 'August 14, 2026';
---

<BaseLayout
        title="Terms of Service"
        description="Terms of Service for iPostDeals — conditions for using this website."
>
  <section class="page">
    <div class="container-narrow">
      <h1>Terms of Service</h1>
      <p class="date">Last updated: {LAST_UPDATED}</p>

      <h2>Acceptance of Terms</h2>
      <p>
        By accessing iPostDeals, you agree to these terms. If you do not
        agree, please do not use this site.
      </p>

      <h2>Content</h2>
      <p>
        Each listing shows the price we observed at the time stated on that
        listing. Prices and availability change rapidly, and we are not the
        seller. We are not responsible for price changes, stock issues, order
        cancellations, or any other aspect of your transaction with a
        third-party retailer or marketplace seller.
      </p>

      <h2>Affiliate Links</h2>
      <p>
        iPostDeals does not currently participate in any affiliate marketing
        program, and no link on this site earns us a commission. If that
        changes, affiliate links will be marked as sponsored and disclosed on
        our About and Privacy pages.
      </p>

      <h2>Limitation of Liability</h2>
      <p>
        iPostDeals is provided "as is" without warranties. We are not liable
        for any damages arising from your use of this site or purchases made
        through linked retailers.
      </p>

      <h2>Changes</h2>
      <p>
        We may update these terms at any time. Continued use of the site after
        changes constitutes acceptance.
      </p>

      <h2>Contact</h2>
      <p>
        Questions? <a href="mailto:daniel@ipostdeals.com">daniel@ipostdeals.com</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 3rem 0 4rem; }
  h1 { margin-bottom: 0.25rem; }
  .date { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2rem; }
  h2 { margin-top: 2rem; margin-bottom: 0.75rem; color: var(--accent); }
</style>
