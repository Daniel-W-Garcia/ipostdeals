---
import DealGrid from '../../components/DealGrid.astro';
import { getActiveDeals } from '../../lib/deals';
import BaseLayout from '../../layouts/BaseLayout.astro';

const activeDeals = await getActiveDeals();

---

<BaseLayout
    title="Current Deals"
    description="Browse active, source-attributed deals from iPostDeals."
>
  <section class="page">
    <div class="container">
      <header class="page-header">
        <h1>Current Deals</h1>
        <p>
          Prices and availability can change. Click any card to view the
          source deal.
        </p>
      </header>

      <DealGrid
          deals={activeDeals}
          emptyMessage="No active deals have been published yet. Check back soon."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding: 3rem 0 4rem;
  }

  .page-header {
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin-bottom: 0.75rem;
  }

  .page-header p {
    margin: 0;
  }
</style>