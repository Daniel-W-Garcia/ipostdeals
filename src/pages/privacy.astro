---
// src/pages/privacy.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
        title="Privacy Policy"
        description="Privacy Policy for iPostDeals — how we collect, use, and protect your information."
>
  <section class="page">
    <div class="container-narrow">
      <h1>Privacy Policy</h1>
      <p class="date">Last updated: {new Date().toLocaleDateString('en-US', {
          year: 'numeric', month: 'long', day: 'numeric'
      })}</p>

      <h2>Information We Collect</h2>
      <p>
        iPostDeals does not collect personal information directly. We do not
        have user accounts, comments, or newsletter signups that would require
        personal data.
      </p>

      <h2>Analytics</h2>
      <p>
        We use Cloudflare Web Analytics, which is privacy-first and does not
        use cookies or track individual users across sites. It provides basic
        page view metrics without collecting personal data.
      </p>

      <h2>Affiliate Links</h2>
      <p>
        Some links on this site are affiliate links. When you click an
        affiliate link and make a purchase, the retailer may set a cookie to
        track that the click came from iPostDeals. These cookies are set by
        the retailer, not by us. Please refer to each retailer's privacy
        policy for details.
      </p>

      <h2>Third-Party Links</h2>
      <p>
        Our site links to third-party retailers. We are not responsible for
        the privacy practices or content of these external sites.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy? Reach out at{' '}
          <a href="mailto:daniel@ipostdeals.com">daniel@ipostdeals.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
      padding: 3rem 0 4rem;
  }

  h1 {
      margin-bottom: 0.25rem;
  }

  .date {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 2rem;
  }

  h2 {
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      color: var(--accent);
  }
</style>
