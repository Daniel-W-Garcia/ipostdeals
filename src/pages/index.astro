---
import DealGrid from '../components/DealGrid.astro';
import { getActiveDeals } from '../lib/deals';
import BaseLayout from '../layouts/BaseLayout.astro';

const activeDeals = await getActiveDeals();

const featuredDeals = activeDeals
    .filter((deal) => deal.data.featured)
    .slice(0, 6);

const latestDeals = activeDeals
    .filter((deal) => !deal.data.featured)
    .slice(0, 6);
---

<BaseLayout
    title="Current Deals Worth Checking"
    description="Source-attributed deals with current observed prices. Click a deal card to view the source offer."
>
  <section class="hero">
    <div class="container">
      <h1>
        Deals worth checking,
        <span class="highlight">without the clutter.</span>
      </h1>

      <p class="hero-subtitle">
        iPostDeals tracks source-attributed product deals and sends you
        directly to the offer. Prices and availability can change quickly.
      </p>

      <div class="hero-actions">
        <a href="/deals/" class="btn btn-primary">Browse Deals</a>
        <a href="/about/" class="btn btn-secondary">How It Works</a>
      </div>
    </div>
  </section>

  {featuredDeals.length > 0 && (
      <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>Featured Deals</h2>
          <a href="/deals/" class="view-all">View all →</a>
        </div>

        <DealGrid deals={featuredDeals} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Latest Deals</h2>
        <a href="/deals/" class="view-all">View all →</a>
      </div>

      <DealGrid
          deals={latestDeals}
          emptyMessage="No active deals have been published yet. Check back soon."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0 3rem;
    text-align: center;
  }

  .hero h1 {
    max-width: 14ch;
    margin-inline: auto;
    margin-bottom: 1.25rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.02em;
  }

  .highlight {
    color: var(--accent);
  }

  .hero-subtitle {
    max-width: 58ch;
    margin-inline: auto;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.5rem;
    border-radius: var(--radius);
    font-size: 0.95rem;
    font-weight: 600;
    transition:
        background-color 0.15s,
        color 0.15s,
        box-shadow 0.15s;
  }

  .btn-primary {
    color: #fff;
    background-color: var(--accent);
  }

  .btn-primary:hover {
    color: #fff;
    background-color: var(--accent-hover);
    box-shadow: 0 0 24px rgba(59, 130, 246, 0.3);
  }

  .btn-secondary {
    color: var(--text-primary);
    background-color: var(--bg-card);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    color: var(--text-primary);
    background-color: var(--bg-card-hover);
  }

  .section {
    padding: 3rem 0;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    margin: 0;
  }

  .view-all {
    flex: 0 0 auto;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>